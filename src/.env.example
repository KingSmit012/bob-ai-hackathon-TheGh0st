# =====================================================================
# Threat Intel Correlation Assistant — Environment Variables
# =====================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit the .env file — it is in .gitignore
# =====================================================================

# ── LLM Provider ─────────────────────────────────────────────────────
# Which LLM to use: "watsonx" (default) or "anthropic"
LLM_PROVIDER=watsonx

# ── IBM watsonx.ai ───────────────────────────────────────────────────
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Anthropic (fallback) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Correlation Settings ─────────────────────────────────────────────
# Time window (minutes) for grouping related alerts
CORRELATION_TIME_WINDOW_MINUTES=30

# ── Priority Weights (should sum to 1.0) ─────────────────────────────
WEIGHT_SEVERITY=0.35
WEIGHT_CONFIDENCE=0.25
WEIGHT_ASSET_CRITICALITY=0.25
WEIGHT_ALERT_DENSITY=0.15

# ── LLM Generation Parameters ───────────────────────────────────────
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ── Application ──────────────────────────────────────────────────────
APP_PORT=8501
APP_ENV=development
